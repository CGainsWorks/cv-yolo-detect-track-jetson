# Training and export image.  CUDA base, so this is the image that fine-tunes
# YOLOX-Tiny and writes the ONNX graphs.
#
# YOLOX and the COCO checkpoint fine-tuning starts from are both Apache-2.0
# (Megvii); docs/licences.md has the detail.  docker/Dockerfile.runtime keeps
# torch and yolox out of the runtime, for size rather than for licence.
#
# The default tag builds against CUDA 12.6, matching the torch wheel index in
# requirements-train.txt.  Override with --build-arg CUDA_TAG=... if the host
# driver is older.  The devel image rather than the runtime one, because
# yolox's setup.py compiles its optional C++ COCO evaluator on Linux and needs
# a compiler and the Python headers for it.

ARG CUDA_TAG=12.6.3-cudnn-devel-ubuntu22.04
FROM nvidia/cuda:${CUDA_TAG}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev python3-venv build-essential libgl1 libglib2.0-0 git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-train.txt requirements-yolox.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt \
 && pip3 install --no-cache-dir -r requirements-train.txt \
 && pip3 install --no-cache-dir --no-deps --no-build-isolation -r requirements-yolox.txt

COPY . .

ENV PYTHONPATH=/app/src

CMD ["make", "train"]
