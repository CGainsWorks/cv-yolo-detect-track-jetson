* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.onnx binary
*.engine binary
*.pt binary

# Git LFS.  Nothing large is committed today: weights and graphs live in a
# GitHub Release and the demo GIF is kept under a megabyte.  These rules exist
# so that if a longer clip or a set of weights is ever added it lands in LFS
# rather than in the pack file.  Install with: git lfs install
*.onnx filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
